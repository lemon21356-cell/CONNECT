{
  "manifest_version": 3,
  "name": "Entry Connect",
  "version": "0.4.1",
  "description": "엔트리 작품 만들기에서 Connect 방을 열고 초대해 실시간 커서·편집 동기화·메시지·계획·사진 공유를 합니다.",
  "permissions": [
    "storage",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "https://playentry.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://playentry.org/*"
      ],
      "js": [
        "redirect.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://playentry.org/ws/*",
        "https://playentry.org/ws"
      ],
      "js": [
        "entry-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://playentry.org/ws/*",
        "https://playentry.org/ws"
      ],
      "js": [
        "coop.js"
      ],
      "css": [
        "coop.css"
      ],
      "run_at": "document_idle"
    }
  ]
}